# ===================================================================
# JAGANNATH TECH SOLUTIONS - ENVIRONMENT CONFIGURATION
# ===================================================================
# Note: Copy this file to .env and set your production credentials.
# NEVER commit the real .env file with secrets to Git.

# Server Port
PORT=3000

# Company Email Inbox where all demo requests and inquiries will be delivered
CONTACT_RECEIVER_EMAIL=info@techjagannath.com

# -------------------------------------------------------------------
# OPTION 1: SMTP Email Service (e.g., AWS SES SMTP, SendGrid, Mailgun, Brevo)
# -------------------------------------------------------------------
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=AKIAEXAMPLEUSER
SMTP_PASS=BEXAMPLESECRETKEY
SMTP_FROM=Jagannath Tech Notifications <notifications@techjagannath.com>
SMTP_SECURE=false

# -------------------------------------------------------------------
# OPTION 2: Webhook / REST Email API Dispatch (Optional)
# -------------------------------------------------------------------
EMAIL_WEBHOOK_URL=
EMAIL_API_KEY=
